{% extends 'base.html.twig' %}

{% block title %}Rechercher un covoiturage
{% endblock %}

{% block body %}
	<div
		class="container mt-4">
		{# Affichage des messages flash #}
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
					{{ message }}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			{% endfor %}
		{% endfor %}

		<div class="hero-section position-relative" style="background-image: url('{{ asset('build/images/nature-search.jpeg') }}'); background-size: cover; background-position: center; height: 400px;">
			<div class="overlay bg-dark position-absolute w-100 h-100" style="opacity: 0.5;"></div>
			<div class="container text-center text-white position-relative" style="z-index: 1;">
				<h1 class="display-4 fw-bold" id="h1main">Rechercher un covoiturage avec EcoRide</h1>
			</div>
		</div>

		<div class="search-bar bg-light py-4 px-3 rounded shadow-sm">
			{{ form_start(form, {'attr': {'class': 'row g-3 align-items-center'}}) }}
			<div class="col-md-3">
				{{ form_row(form.lieuDepart) }}
			</div>
			<div class="col-md-3">
				{{ form_row(form.lieuArrivee) }}
			</div>
			<div class="col-md-3">
				{{ form_row(form.dateDepart) }}
			</div>
			<div class="col-md-3 d-flex align-items-end">
				<button type="submit" class="btn btn-success w-100">
					<i class="fas fa-search"></i>
					Rechercher
				</button>
			</div>
			{{ form_end(form) }}
		</div>

		{% if searchCriteria is not empty %}
			<div class="mb-4">
				<h5>Critères de recherche :</h5>
				<p>
					De
					<strong>{{ searchCriteria.lieuDepart }}</strong>
					à
					<strong>{{ searchCriteria.lieuArrivee }}</strong>
					le
					<strong>{{ searchCriteria.dateDepart|date('d/m/Y') }}</strong>
				</p>
			</div>
		{% endif %}

		<div class="row mt-5">
			<div class="col-md-9" id="results-container">
				{% if covoiturages is not empty %}
					<div class="row">
						{% for covoiturage in covoiturages %}
							<div class="col-md-6 mb-4">
								<div class="card">
									<div class="card-body">
										<div class="d-flex align-items-center mb-3">
											{% if covoiturage.user.imagename %}
												<img src="{{ asset('images/users/' ~ covoiturage.user.imageName) }}" alt="Photo de {{ covoiturage.user.pseudo }}" class="rounded-circle me-3" width="50" height="50">
											{% else %}
												<div class="rounded-circle bg-secondary me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
													<i class="fas fa-user text-white"></i>
												</div>
											{% endif %}
											<div>
												<h5 class="card-title mb-0">{{ covoiturage.user.pseudo }}</h5>
												<div class="text-warning">
													{% set totalNote = 0 %}
													{% set count = 0 %}
													{% for avis in covoiturage.user.avis %}
														{% if avis.note is not null %}
															{% set totalNote = totalNote + avis.note|number_format(0, '', '') %}
															{% set count = count + 1 %}
														{% endif %}
													{% endfor %}
													{% if count > 0 %}
														{% set averageNote = totalNote / count %}
														{% for i in 1..5 %}
															{% if i <= averageNote %}
																<i class="fas fa-star"></i>
															{% else %}
																<i class="far fa-star"></i>
															{% endif %}
														{% endfor %}
													{% else %}
														<span>Aucune note disponible</span>
													{% endif %}
												</div>
											</div>
										</div>

										<p class="card-text">
											<strong>
												<i class="fas fa-map-marker-alt text-primary"></i>
												Départ :</strong>
											{{ covoiturage.lieuDepart }}<br>
											<i class="fas fa-calendar-alt"></i>
											{{ covoiturage.dateDepart|date('d/m/Y') }}
											à
											{{ covoiturage.heureDepart|date('H:i') }}
										</p>

										<p class="card-text">
											<strong>
												<i class="fas fa-map-marker-alt text-success"></i>
												Arrivée :</strong>
											{{ covoiturage.lieuArrivee }}<br>
											<i class="fas fa-calendar-alt"></i>
											{{ covoiturage.dateArrivee|date('d/m/Y') }}
											à
											{{ covoiturage.heureArrivee|date('H:i') }}
										</p>

										<div class="d-flex justify-content-between align-items-center mb-3">
											<span class="badge bg-info">
												<i class="fas fa-users"></i>
												{{ covoiturage.nbPlace }}
												place(s)
											</span>
											<span class="badge bg-success">
												<i class="fas fa-coins"></i>
												{{ covoiturage.prixPersonne }}
												€
											</span>
											{% if covoiturage.voiture.energie == 'Électrique' %}
												<span class="badge bg-primary">
													<i class="fas fa-leaf"></i>
													Écologique
												</span>
											{% endif %}
										</div>

										<a href="{{ path('app_covoiturage_detail', {id: covoiturage.id}) }}" class="btn btn-outline-success w-100">Voir les détails</a>
									</div>
								</div>
							</div>

						{% endfor %}
					</div>
				{% else %}
					<p class="text-muted">Aucun covoiturage trouvé.</p>
				{% endif %}
			</div>

			<div class="col-md-3">
				<div class="filters bg-light py-4 px-3 rounded shadow-sm">
					<h5 class="mb-4">Filtres</h5>
					<form
						id="filters-form" class="row gy-3 align-items-center">
						<!-- Prix Maximum -->
						<div class="col-12">
							<label for="prixMax" class="form-label fw-semibold">Prix maximum (€)</label>
							<input type="number" id="prixMax" name="prixMax" class="form-control" placeholder="Entrez un montant">
						</div>

						<!-- Durée Maximale -->
						<div class="col-12">
							<label for="dureeMax" class="form-label fw-semibold">Durée maximale (minutes)</label>
							<input type="number" id="dureeMax" name="dureeMax" class="form-control" placeholder="Ex. 120">
						</div>

						<!-- Voyage écologique -->
						<div class="form-check col-12">
							<input type="checkbox" id="ecologique" name="ecologique" class="form-check-input">
							<label for="ecologique" class="form-check-label fw-semibold">Voyage écologique</label>
						</div>

						<!-- Note minimale -->
						<div class="col-12">
							<label for="noteMinimale" class="form-label fw-semibold">Note</label>
							<div class="star-rating d-flex gap-1">
								{% for i in 1..5 %}
									<i class="far fa-star text-warning" data-value="{{ i }}" style="cursor: pointer;"></i>
								{% endfor %}
							</div>
							<input type="hidden" id="noteMinimale" name="noteMinimale">
						</div>

						<!-- Boutons -->
						<div class="col-12">
							<button type="button" id="apply-filters" class="btn btn-success w-100 mb-2">Appliquer les filtres</button>
							<button type="button" id="reset-filters" class="btn btn-outline-secondary w-100">Réinitialiser</button>
						</div>
					</form>
				</div>
			</div>

		</div>

		{% if upcomingCovoiturages is not empty %}
			<div class="alert alert-info mt-5">
				<h5>
					<i class="fas fa-calendar-alt"></i>
					Prochains trajets disponibles :</h5>
				<div class="list-group mt-2">
					{% for prochain in upcomingCovoiturages %}
						<a href="{{ path('app_search', { 'search_covoiturage[lieuDepart]': prochain.lieuDepart, 'search_covoiturage[lieuArrivee]': prochain.lieuArrivee, 'search_covoiturage[dateDepart]': prochain.dateDepart|date('Y-m-d') }) }}" class="list-group-item list-group-item-action">
							{{ prochain.dateDepart|date('d/m/Y') }}
							à
							{{ prochain.heureDepart|date('H:i') }}
							-
							{{ prochain.prixPersonne }}
							crédits -
							{{ prochain.nbPlace }}
							place(s)
						</a>
					{% endfor %}
				</div>
			</div>
		{% endif %}
	</div>

	{% block javascripts %}
		{{ parent() }}
		<script src="{{ asset('js/filters.js') }}"></script>
	{% endblock %}
{% endblock %}
