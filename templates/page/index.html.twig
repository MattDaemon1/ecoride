{% extends 'base.html.twig' %}

{% block title %}EcoRide - Accueil{% endblock %}

{% block body %}

<!-- Section avec image de fond -->
<div class="hero-section position-relative" style="background-image: url('{{ asset('build/images/nature.jpeg') }}'); background-size: cover; background-position: center; height: 400px;">
    <div class="overlay bg-dark position-absolute w-100 h-100" style="opacity: 0.5;"></div>
    <div class="container text-center text-white position-relative" style="z-index: 1;">
        <h1 class="display-4 fw-bold" id="h1main">Planifiez votre prochain trajet en toute simplicité avec EcoRide.</h1>
    </div>
</div>

<!-- Barre de recherche -->
<div class="search-bar bg-light py-4 px-3 rounded shadow-sm">
    {% if form is defined %}
        {{ form_start(form) }}
        <div class="row align-items-center ">
            <div class="col">
                {{ form_row(form.lieuDepart) }}
            </div>
            <div class="col">
                {{ form_row(form.lieuArrivee) }}
            </div>
            <div class="col">
                {{ form_row(form.dateDepart) }}
            </div>
            <div class="col d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fas fa-search"></i> Rechercher
                </button>
            </div>
        </div>
        {{ form_end(form) }}
    {% else %}
        <p>Formulaire non disponible.</p>
    {% endif %}
</div>

	<div class="row flex-lg-row-reverse align-items-center g-5 py-5">
		<div class="col-10 col-sm-8 col-lg-6">
			<img src="{{ asset('build/images/logo_Ecoride.png') }}" class="d-block mx-lg-auto img-fluid" alt="Logo Ecoride" width="700" height="500" loading="lazy">
		</div>
		<div class="col-lg-6">
			<h1>Bienvenue sur la plateforme EcoRide</h1>
			<p class="lead">Quickly design and customize responsive mobile-first sites with Bootstrap, the world’s most popular front-end open source toolkit, featuring Sass variables and mixins, responsive grid system, extensive prebuilt components, and powerful JavaScript plugins.</p>
			<div class="d-grid gap-2 d-md-flex justify-content-md-start">
				<button type="button" class="btn btn-success btn-lg">Primary</button>
				<button type="button" class="btn btn-outline-secondary btn-lg px-4">Default</button>
			</div>
		</div>
	</div>

{% endblock %}
