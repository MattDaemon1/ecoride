<form method="post" action="{{ path('configuration_update') }}">
    <input type="hidden" name="configuration_id" value="{{ configuration.id }}">

    <div class="form-check">
        <input
            class="form-check-input"
            type="checkbox"
            id="chauffeur"
            name="chauffeur"
            value="oui"
            {% if configuration.parametres|filter(param => param.propriete == 'chauffeur' and param.valeur == 'oui')|length > 0 %} checked {% endif %}
        >
        <label class="form-check-label" for="chauffeur">Chauffeur</label>
    </div>

    <div class="form-check">
        <input
            class="form-check-input"
            type="checkbox"
            id="passager"
            name="passager"
            value="oui"
            {% if configuration.parametres|filter(param => param.propriete == 'passager' and param.valeur == 'oui')|length > 0 %} checked {% endif %}
        >
        <label class="form-check-label" for="passager">Passager</label>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Mettre à jour</button>
</form>
