{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-4">Bienvenue, {{ app.user.pseudo }}</h1>

    <!-- Section des rôles -->
    <div class="card shadow-lg mb-4">
        <div class="card-header text-center">
            <h2>Votre rôle</h2>
        </div>
        <div class="card-body">
            <ul>
                {% if 'chauffeur' in roles %}
                    <li class="text-success">Chauffeur</li>
                {% endif %}
                {% if 'passager' in roles %}
                    <li class="text-success">Passager</li>
                {% endif %}
            </ul>

            <!-- Formulaire pour modifier les rôles -->
            <div class="card-header text-center mt-4">
                <h3>Modifier vos rôles</h3>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('user_update_roles') }}">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="role_chauffeur" name="roles[]" value="chauffeur" {% if 'chauffeur' in roles %} checked {% endif %}>
                        <label class="form-check-label" for="role_chauffeur">Chauffeur</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="role_passager" name="roles[]" value="passager" {% if 'passager' in roles %} checked {% endif %}>
                        <label class="form-check-label" for="role_passager">Passager</label>
                    </div>
                    <button type="submit" class="btn btn-success mt-3">Enregistrer les modifications</button>
                </form>
            </div>
        </div>
    </div>

    {% if 'chauffeur' in roles %}
        <!-- Formulaire pour ajouter un véhicule -->
        <div class="container my-5">
            <h2 class="text-center mb-4">Renseigner votre véhicule</h2>
            <div class="card shadow-sm p-4">
                {{ form_start(voitureForm, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_row(voitureForm.immatriculation, { 'label': 'Plaque d\'immatriculation', 'attr': { 'class': 'form-control', 'placeholder': 'Ex : AB-123-CD' } }) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_row(voitureForm.datePremiereImmatriculation, { 'label': 'Date de première immatriculation', 'attr': { 'class': 'form-control', 'placeholder': 'jj/mm/aaaa' } }) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_row(voitureForm.modele, { 'label': 'Modèle', 'attr': { 'class': 'form-control', 'placeholder': 'Ex : Clio' } }) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_row(voitureForm.marque, { 'label': 'Marque', 'attr': { 'class': 'form-control', 'placeholder': 'Ex : Renault' } }) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_row(voitureForm.couleur, { 'label': 'Couleur', 'attr': { 'class': 'form-control', 'placeholder': 'Ex : Rouge' } }) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_row(voitureForm.energie, { 'label': 'Énergie', 'attr': { 'class': 'form-control', 'placeholder': 'Ex : Électrique' } }) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col text-center">
                        <button type="submit" class="btn btn-success btn-lg w-50">Ajouter ce véhicule</button>
                    </div>
                </div>
                {{ form_end(voitureForm) }}
            </div>
        </div>

        <!-- Liste des voyages -->
        <div class="container my-5">
            <div class="card shadow-sm p-4">
                <h2 class="text-center mb-4 text-success">Vos voyages</h2>

                {% if app.user.covoiturages|length > 0 %}
                    <ul class="list-group">
                        {% for covoiturage in app.user.covoiturages %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>{{ covoiturage.lieuDepart }} => {{ covoiturage.lieuArrivee }} - {{ covoiturage.dateDepart|date('d/m/Y H:i') }}</span>
                                <div class="btn-group">
                                    <a href="{{ path('covoiturages_edit', { id: covoiturage.id }) }}" class="btn btn-warning btn-sm">Modifier</a>

                                    <form method="post" action="{{ path('covoiturages_delete', { id: covoiturage.id }) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce covoiturage ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ covoiturage.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="col text-center">
                            <a href="{{ path('saisir_un_voyage') }}" class="btn btn-success btn-lg w-50">Saisir un voyage</a>
                            </div>
                {% else %}
                    <p class="text-center text-muted">Vous n'avez aucun voyage enregistré.</p>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <!-- Liste des véhicules -->
    <div class="container my-5">
        <h2 class="text-center mb-4 text-success">Vos véhicules</h2>
        {% if app.user.voitures|length > 0 %}
            <ul class="list-group">
                {% for voiture in app.user.voitures %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>{{ voiture.immatriculation }} - {{ voiture.marque.libelle }} {{ voiture.modele }}</span>
                        <div class="btn-group">
                            <a href="{{ path('voiture_edit', { id: voiture.id }) }}" class="btn btn-warning btn-sm">Modifier</a>
<form method="post" action="{{ path('voiture_delete', {'id': voiture.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce véhicule ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.id) }}">
    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
</form>

                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-center text-muted">Aucun véhicule enregistré.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
