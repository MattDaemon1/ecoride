{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord
{% endblock %}

{% block body %}
<div class="container mt-5">
	<h1 class="text-center mb-4">Bienvenue,
		{{ app.user.pseudo }}</h1>

	<!-- Section des rôles -->
	<div class="card shadow-lg mb-4">
		<div class="card-header text-center">
			<h2>Votre rôle</h2>
		</div>
		<div class="card-body">
			<ul>
				{% if 'chauffeur' in roles %}
					<li class="text-success">Chauffeur</li>
				{% endif %}
				{% if 'passager' in roles %}
					<li class="text-success">Passager</li>
				{% endif %}
			</ul>

			<!-- Formulaire pour modifier les rôles -->
			<div class="card-header text-center mt-4">
				<h3>Modifier vos rôles</h3>
			</div>
			<div class="card-body">
				<form method="post" action="{{ path('user_update_roles') }}">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="role_chauffeur" name="roles[]" value="chauffeur" {% if 'chauffeur' in roles %} checked {% endif %}>
						<label class="form-check-label" for="role_chauffeur">Chauffeur</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="role_passager" name="roles[]" value="passager" {% if 'passager' in roles %} checked {% endif %}>
						<label class="form-check-label" for="role_passager">Passager</label>
					</div>
					<button type="submit" class="btn btn-success mt-3">Enregistrer les modifications</button>
				</form>
			</div>

{% if 'chauffeur' in roles %}
<div class="container my-5">
    <h2 class="text-center mb-4">Renseigner votre véhicule</h2>
    <p class="text-center text-muted">Veuillez fournir les informations nécessaires pour ajouter un véhicule à votre profil.</p>
    <div class="card shadow-sm p-4">
        {{ form_start(voitureType, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(voitureType.Immatriculation, { 
                    'label': 'Plaque d\'immatriculation', 
                    'attr': { 'class': 'form-control', 'placeholder': 'Ex : AB-123-CD' } 
                }) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(voitureType.datePremiereImmatriculation, { 
                    'label': 'Date de première immatriculation', 
                    'attr': { 'class': 'form-control', 'placeholder': 'jj/mm/aaaa' } 
                }) }}
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(voitureType.modele, { 
                    'label': 'Modèle', 
                    'attr': { 'class': 'form-control', 'placeholder': 'Ex : Clio' } 
                }) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(voitureType.marque, { 
                    'label': 'Marque', 
                    'attr': { 'class': 'form-control', 'placeholder': 'Ex : Renault' } 
                }) }}
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(voitureType.couleur, { 
                    'label': 'Couleur', 
                    'attr': { 'class': 'form-control', 'placeholder': 'Ex : Rouge' } 
                }) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(voitureType.energie, { 
                    'label': 'Énergie', 
                    'attr': { 'class': 'form-control', 'placeholder': 'Ex : Électrique' } 
                }) }}
            </div>
        </div>
        <div class="row">
            <div class="col text-center">
                <button type="submit" class="btn btn-success btn-lg w-50">Ajouter ce véhicule</button>
            </div>
        </div>
        {{ form_end(voitureType) }}
    </div>
</div>
{% endif %}

                        
                    
                     
                

               <!-- Liste des véhicules associés -->
<div class="container my-5">
    <h2 class="text-center mb-4 text-success">Vos véhicules</h2>
    {% if app.user.voitures is not empty %}
        <ul class="list-group">
    {% for voiture in app.user.voitures %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>{{ voiture.Immatriculation }} - {{ voiture.marque.libelle }} {{ voiture.modele }}</span>
            <div>
                <a href="{{ path('voiture_edit', { id: voiture.id }) }}" class="btn btn-warning btn-sm">Modifier</a>
                <form method="post" action="{{ path('voiture_delete', { id: voiture.id }) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce véhicule ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                </form>
            </div>
        </li>
    {% endfor %}
</ul>
    {% else %}
        <p class="text-center text-muted">Vous êtes configuré comme passager. Aucun véhicule enregistré.</p>
    {% endif %}
</div>

<!-- Section des informations -->
<div class="card shadow-lg mb-4">
    <div class="card-header text-center bg-light">
        <h2 class="text-dark">Vos informations</h2>
    </div>
    <div class="card-body">
        <p class="text-center"><strong>Crédits disponibles :</strong> {{ app.user.credit }}</p>
    </div>
</div>

<!-- Section des participations -->
<div class="card shadow-lg mb-4">
    <div class="card-header text-center bg-light">
        <h2 class="text-dark">Vos participations</h2>
    </div>
    <div class="card-body">
        {% if app.user.covoiturages is not empty %}
            <ul class="list-group">
                {% for covoiturage in app.user.covoiturages %}
                    <li class="list-group-item">
                        {{ covoiturage.lieuDepart }} => {{ covoiturage.lieuArrivee }} - {{ covoiturage.dateDepart|date('d/m/Y H:i') }}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-center text-muted">Vous n'avez pas encore participé à un covoiturage.</p>
        {% endif %}
    </div>
    <div class="card-footer text-center">
        <a href="{{ path('search_route') }}" class="btn btn-success btn-lg w-50">Rechercher un covoiturage</a>
    </div>
</div>
</div>
{% endblock %}

