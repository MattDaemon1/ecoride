{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-4">Bienvenue, {{ user.pseudo }}</h1>

    <!-- Affichage des rôles actuels -->
    <div class="card shadow-lg mb-4">
        <div class="card-header text-center">
            <h2>Vos rôles actuels</h2>
        </div>
        <div class="card-body">
            <ul>
                <li>Chauffeur : <strong>{{ roles.chauffeur ? 'Actif' : 'Inactif' }}</strong></li>
                <li>Passager : <strong>{{ roles.passager ? 'Actif' : 'Inactif' }}</strong></li>
            </ul>
        </div>
    </div>
    <!-- Formulaire pour modifier les rôles -->
    <div class="card shadow-lg">
        <div class="card-header text-center">
            <h3>Modifier vos préférences</h3>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('user_dashboard') }}">
                <div class="form-check">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="chauffeur"
                        name="chauffeur"
                        value="oui"
                        {% if roles.chauffeur %} checked {% endif %}
                    >
                    <label class="form-check-label" for="chauffeur">Chauffeur</label>
                </div>
                <div class="form-check">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        id="passager"
                        name="passager"
                        value="oui"
                        {% if roles.passager %} checked {% endif %}
                    >
                    <label class="form-check-label" for="passager">Passager</label>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
            </form>
        </div>
    </div>

    <!-- Formulaires pour Chauffeur -->
    {% if roles.chauffeur %}
        <div class="card shadow-lg mb-4">
            <div class="card-header text-center">
                <h3>Ajouter un véhicule</h3>
            </div>
            <div class="card-body">
                {{ form_start(voitureForm) }}
                {{ form_widget(voitureForm) }}
                <button type="submit" class="btn btn-primary mt-3">Ajouter un véhicule</button>
                {{ form_end(voitureForm) }}
            </div>
        </div>

        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h3>Ajouter un covoiturage</h3>
            </div>
            <div class="card-body">
                {{ form_start(covoiturageForm) }}
                {{ form_widget(covoiturageForm) }}
                <button type="submit" class="btn btn-primary mt-3">Ajouter un covoiturage</button>
                {{ form_end(covoiturageForm) }}
            </div>
        </div>
    {% else %}
        <div class="alert alert-info text-center">
            Vous êtes passager. Aucune action n'est requise ici.
        </div>
    {% endif %}
</div>



   
        <!-- Liste des voyages -->
        <div class="container my-5">
            <div class="card shadow-sm p-4">
                <h2 class="text-center mb-4 text-success">Vos voyages</h2>

                {% if app.user.covoiturages|length > 0 %}
                    <ul class="list-group">
                        {% for covoiturage in app.user.covoiturages %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>{{ covoiturage.lieuDepart }} => {{ covoiturage.lieuArrivee }} - {{ covoiturage.dateDepart|date('d/m/Y H:i') }}</span>
                                <div class="btn-group">
                                    <a href="{{ path('covoiturages_edit', { id: covoiturage.id }) }}" class="btn btn-warning btn-sm">Modifier</a>

                                    <form method="post" action="{{ path('covoiturages_delete', { id: covoiturage.id }) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce covoiturage ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ covoiturage.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="col text-center">
                            <a href="{{ path('saisir_un_voyage') }}" class="btn btn-success btn-lg w-50">Saisir un voyage</a>
                            </div>
                {% else %}
                    <p class="text-center text-muted">Vous n'avez aucun voyage enregistré.</p>
                {% endif %}
            </div>
        </div>
  

    <!-- Liste des véhicules -->
    <div class="container my-5">
        <h2 class="text-center mb-4 text-success">Vos véhicules</h2>
        {% if app.user.voitures|length > 0 %}
            <ul class="list-group">
                {% for voiture in app.user.voitures %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>{{ voiture.immatriculation }} - {{ voiture.marque.libelle }} {{ voiture.modele }}</span>
                        <div class="btn-group">
                            <a href="{{ path('voiture_edit', { id: voiture.id }) }}" class="btn btn-warning btn-sm">Modifier</a>
<form method="post" action="{{ path('voiture_delete', {'id': voiture.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce véhicule ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.id) }}">
    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
</form>

                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-center text-muted">Aucun véhicule enregistré.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
