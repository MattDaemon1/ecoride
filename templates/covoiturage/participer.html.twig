<div class="container mt-5">
    <div class="card">
        <div class="card-header text-center">
            <h1 class="h4">Confirmer votre participation</h1>
        </div>
        <div class="card-body">
            <p><strong>Trajet :</strong> {{ covoiturage.lieuDepart }} - {{ covoiturage.lieuArrivee }} </p>
            <p><strong>Prix en crédits :</strong> {{ covoiturage.prixPersonne }}</p>
            <p><strong>Places restantes :</strong> {{ covoiturage.nbPlace }}</p>

            <form method="post">
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">Confirmer</button>
                    <a href="{{ path('covoiturage_detail', { id: covoiturage.id }) }}" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
