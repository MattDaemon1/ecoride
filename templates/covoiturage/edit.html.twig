{% extends 'base.html.twig' %}

{% block title %}Modifier le covoiturage{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="text-center mb-4">Modifier le covoiturage</h2>
        <div class="card shadow-sm p-4">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="text-center">
                <button type="submit" class="btn btn-success btn-lg w-50">Enregistrer les modifications</button>
            </div>
            {{ form_end(form) }}
        </div>
        <div class="text-center mt-3">
            <a href="{{ path('user_dashboard') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </div>
{% endblock %}
