{% extends 'base.html.twig' %}

{% block title %}Détails du covoiturage
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h1 class="mb-4 text-center">Détails du covoiturage</h1>

		<div class="card shadow-lg">
			<div
				class="card-body">
				<!-- Section Trajet -->
				<h5 class="card-title text-primary">Trajet</h5>
				<p>
					<strong>Départ :</strong>
					{{ covoiturage.lieuDepart }}
					-
					{{ covoiturage.dateDepart|date('d/m/Y') }}
					à
					{{ covoiturage.heureDepart|date('H:i') }}</p>
				<p>
					<strong>Arrivée :</strong>
					{{ covoiturage.lieuArrivee }}
					-
					{{ covoiturage.dateArrivee|date('d/m/Y') }}
					à
					{{ covoiturage.heureArrivee|date('H:i') }}</p>

				<hr>

				<!-- Section Informations Conducteur -->
				<h5 class="card-title text-primary">Informations sur le conducteur</h5>
				<p>
					<strong>Conducteur :</strong>
					{{ covoiturage.user.pseudo }}</p>
				<p>
					<strong>Note moyenne :</strong>
					{% if covoiturage.user.averageNote is not null %}
						{% for i in 1..5 %}
							{% if i <= covoiturage.user.averageNote %}
								<i class="fas fa-star text-warning"></i>
							{% else %}
								<i class="far fa-star"></i>
							{% endif %}
						{% endfor %}
						({{ covoiturage.user.averageNote|number_format(1) }}/5)
					{% else %}
						<em>Aucune note disponible</em>
					{% endif %}
				</p>


				<!-- Section Préférences Conducteur -->
				{# <h5 class="card-title text-primary mt-3">Préférences du conducteur</h5>
				                <ul class="list-unstyled">
				                    <li>
				                        <i class="fas fa-smoking"></i>
				                        Fumeur :
				                        {{ covoiturage.user.preferences.fumeur ? 'Oui' : 'Non' }}</li>
				                    <li>
				                        <i class="fas fa-paw"></i>
				                        Animaux acceptés :
				                        {{ covoiturage.user.preferences.animaux ? 'Oui' : 'Non' }}</li>
				                    <li>
				                        <i class="fas fa-music"></i>
				                        Musique :
				                        {{ covoiturage.user.preferences.musique ? 'Oui' : 'Non' }}</li>
				                </ul> #}

				<hr>

				<!-- Section Véhicule -->
				<h5 class="card-title text-primary">Détails du véhicule</h5>
				<p>
					<strong>Marque :</strong>
					{{ covoiturage.voiture.marque }}</p>
				<p>
					<strong>Modèle :</strong>
					{{ covoiturage.voiture.modele }}</p>
				<p>
					<strong>Énergie :</strong>
					{{ covoiturage.voiture.energie }}</p>
				{% if covoiturage.voiture.energie == 'Électrique' %}
					<span class="badge bg-success">Écologique</span>
				{% endif %}

				<hr>

				<!-- Section Avis -->
				<h5 class="card-title text-primary">Avis des passagers</h5>
				{% if covoiturage.user.avis is not empty %}
					{% for avis in covoiturage.user.avis %}
						<div class="card my-2">
							<div class="card-body">
								<p>
									<strong>{{ avis.user.pseudo }}
										:</strong>
									{{ avis.commentaire }}</p>
								<p>
									<i class="fas fa-star text-warning"></i>
									{{ avis.note }}/5</p>
							</div>
						</div>
					{% endfor %}
				{% else %}
					<p>Aucun avis disponible pour ce conducteur.</p>
				{% endif %}

				<hr>

				<!-- Section Prix et places -->
				<h5 class="card-title text-primary">Prix et places</h5>
				<p>
					<strong>Prix par personne :</strong>
					{{ covoiturage.prixPersonne }}
					€</p>
				<p>
					<strong>Vos crédits :</strong>
					{{ app.user.credit }}</p>
				<p>
					<strong>Places disponibles :</strong>
					{{ covoiturage.nbPlace }}</p>


				<div class="text-center mt-4">
    {% if covoiturage.nbPlace > 0 %}
        <!-- Bouton pour ouvrir le modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmationModal">
            Participer
        </button>
    {% else %}
        <div class="alert alert-danger mt-4" role="alert">
            <strong>Plus de places disponibles pour ce covoiturage.</strong>
        </div>
    {% endif %}
</div>
		</div>

		<!-- Bouton Retour -->
		<div class="text-center mt-4">
			

			<a href="{{ path('app_search') }}" class="btn btn-secondary">Retour à la recherche</a>
		</div>
	</div>

    <!-- Modal Bootstrap -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalLabel">Confirmer votre participation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir participer à ce covoiturage ?</p>
                <p><strong>Trajet :</strong> {{ covoiturage.lieuDepart }} - {{ covoiturage.lieuDepart }}</p>
                <p><strong>Prix en crédits :</strong> {{ covoiturage.prixPersonne }}</p>
                <p><strong>Places restantes :</strong> {{ covoiturage.nbPlace }}</p>
            </div>
            <div class="modal-footer">
                <form method="post">
                    <button type="submit" class="btn btn-success">Confirmer</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    <script>
        // Affiche le modal de confirmation
        $('#confirmationModal').modal('show');
    </script>
{% endblock %}
